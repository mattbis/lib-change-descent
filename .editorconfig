# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

# Matches multiple files with brace expansion notation
# Set default charset
[*.{,mjs,js,py,cmd,bat,sh,ps1,ts,zig,zon}]
indent_size = 4

[*.{zig,zon}]
indent_size = 4
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
